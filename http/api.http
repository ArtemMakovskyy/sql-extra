@base_url = http://localhost:8080

### Get All Products
GET {{base_url}}/api/products

### Get Product by ID
GET {{base_url}}/api/products/1

### Create Product
POST {{base_url}}/api/products
Content-Type: application/json

{
  "itemId": 1001,
  "name": "Premium Wine Collection",
  "category": "wine",
  "price": 29.99,
  "shortDescription": "Exclusive wine selection"
}

### Update Product
PUT {{base_url}}/api/products/1001
Content-Type: application/json

{
  "itemId": 1001,
  "name": "Premium Wine Collection Updated",
  "category": "wine",
  "price": 39.99,
  "shortDescription": "Updated description"
}

### Delete Product
DELETE {{base_url}}/api/products/1001

### Get All Sessions
GET {{base_url}}/api/sessions

### Get Session by ID
GET {{base_url}}/api/sessions/ga_abc123

### Create Session
POST {{base_url}}/api/sessions
Content-Type: application/json

{
  "gaSessionId": "ga_test123",
  "date": "2026-01-15"
}

### Update Session
PUT {{base_url}}/api/sessions/ga_test123
Content-Type: application/json

{
  "gaSessionId": "ga_test123",
  "date": "2026-01-20"
}

### Delete Session
DELETE {{base_url}}/api/sessions/ga_test123

### Get All Session Params
GET {{base_url}}/api/session-params

### Get Session Params by ID
GET {{base_url}}/api/session-params/ga_abc123

### Create Session Params
POST {{base_url}}/api/session-params
Content-Type: application/json

{
  "gaSessionId": "ga_test123",
  "device": "desktop",
  "mobileModelName": "iPhone 14",
  "operatingSystem": "iOS",
  "language": "en-US",
  "browser": "Chrome",
  "continent": "Europe",
  "country": "United States",
  "medium": "organic",
  "name": "direct",
  "channel": "Organic Search"
}

### Update Session Params
PUT {{base_url}}/api/session-params/ga_test123
Content-Type: application/json

{
  "gaSessionId": "ga_test123",
  "device": "mobile",
  "operatingSystem": "Android",
  "language": "en-GB",
  "browser": "Firefox",
  "continent": "North America",
  "country": "Canada",
  "medium": "paid",
  "name": "referral",
  "channel": "Paid Search"
}

### Delete Session Params
DELETE {{base_url}}/api/session-params/ga_test123

### Get All Accounts
GET {{base_url}}/api/accounts

### Get Account by ID
GET {{base_url}}/api/accounts/1

### Create Account
POST {{base_url}}/api/accounts
Content-Type: application/json

{
  "id": 1001,
  "sendInterval": 14,
  "isVerified": 1,
  "isUnsubscribed": 0
}

### Update Account
PUT {{base_url}}/api/accounts/1001
Content-Type: application/json

{
  "id": 1001,
  "sendInterval": 7,
  "isVerified": 1,
  "isUnsubscribed": 0
}

### Delete Account
DELETE {{base_url}}/api/accounts/1001

### Get All Account Sessions
GET {{base_url}}/api/account-sessions

### Get Account Session by ID
GET {{base_url}}/api/account-sessions/1/ga_abc123

### Create Account Session
POST {{base_url}}/api/account-sessions
Content-Type: application/json

{
  "accountId": 1,
  "gaSessionId": "ga_test123"
}

### Delete Account Session
DELETE {{base_url}}/api/account-sessions/1/ga_test123

### Get Account Sessions by Account ID
GET {{base_url}}/api/account-sessions/account/1

### Get Account Sessions by Session ID
GET {{base_url}}/api/account-sessions/session/ga_abc123

